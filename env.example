# Application
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=
DATA_ENCRYPTION_KEY=
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=3
AUTH_ACCOUNT_LOCKOUT_SECONDS=60

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials >
# OAuth 2.0 Client ID, type "Web application"). Same value is read by the
# backend (GOOGLE_OAUTH_CLIENT_ID) and exposed to the frontend build
# (VITE_GOOGLE_CLIENT_ID) — keep them identical. Add every origin that will
# load the login page (e.g. http://localhost:5173, your deployed domain) to
# that client's "Authorized JavaScript origins" in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digidara_voice_ai

# Active telephony provider
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
WEBHOOK_BASE_URL=https://your-public-host
PLIVO_STREAM_BASE_URL=wss://your-public-host
PLIVO_VALIDATE_SIGNATURES=true
PLIVO_VALIDATE_WEBSOCKET_SIGNATURES=false
PLIVO_STREAM_TOKEN_SECRET=
# Inbound DID -> organization/campaign routing is now data-driven: register
# each Plivo number via POST /phone-numbers (see app/api/phone_numbers.py)
# instead of setting a single global campaign here.
PLIVO_INBOUND_LANGUAGE=tamil

# OpenAI Realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_MODEL_ENGLISH=
OPENAI_REALTIME_MODEL_TAMIL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE_ENGLISH=shimmer
OPENAI_REALTIME_VOICE_ENGLISH_CUSTOM_ID=
OPENAI_REALTIME_VOICE_TAMIL=marin
OPENAI_REALTIME_VOICE_TAMIL_CUSTOM_ID=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_MODEL_TAMIL=gpt-4o-transcribe
OPENAI_TRANSCRIPTION_LANGUAGE_TAMIL=
OPENAI_SERVER_VAD_SILENCE_MS_ENGLISH=650
OPENAI_SERVER_VAD_THRESHOLD_ENGLISH=0.6
OPENAI_VAD_EAGERNESS_TAMIL=high

# Shared prompt plus Tamil/English turn control
MAX_RESPONSE_SENTENCES=2
TARGET_RESPONSE_WORDS_MAX=30
TARGET_RESPONSE_WORDS_MAX_ENGLISH=20
TARGET_RESPONSE_WORDS_MAX_TAMIL=30
INITIAL_PROMPT_MAX_ESTIMATED_TOKENS=1200
TAMIL_CORE_KNOWLEDGE_MAX_CHARS=1800
ENGLISH_CORE_KNOWLEDGE_MAX_CHARS=1800
TAMIL_BARGE_IN_CONFIRM_MS=80
TAMIL_BARGE_IN_MIN_VOICED_FRAMES=2
TAMIL_TURN_VOICED_RMS=220
TAMIL_TURN_MIN_PEAK_RMS=240
TAMIL_TURN_MIN_DURATION_MS=240
TAMIL_TURN_MIN_VOICED_FRAMES=3
ENGLISH_BARGE_IN_CONFIRM_MS=100
ENGLISH_BARGE_IN_MIN_VOICED_FRAMES=2
ENGLISH_TURN_VOICED_RMS=220
ENGLISH_TURN_MIN_PEAK_RMS=240
ENGLISH_TURN_MIN_DURATION_MS=160
ENGLISH_TURN_MIN_VOICED_FRAMES=2
PLIVO_PLAYBACK_CHECKPOINT_INTERVAL_MS=250
CALL_INACTIVITY_REPROMPT_SECONDS=15
CALL_INACTIVITY_HANGUP_SECONDS=10

# Shared guardrails for individual and bulk calls. Only the duration limit
# automatically terminates a call; the other thresholds create review alerts.
CALL_MAX_DURATION_SECONDS=900
CALL_ESTIMATED_COST_ALERT_INR=50
CALL_ESTIMATED_COST_PER_MINUTE_ALERT_INR=8
CALL_TURNS_PER_MINUTE_ALERT=8
CALL_INTERRUPTION_ALERT_COUNT=5
CALL_FALSE_TURN_ALERT_COUNT=3

# Optional usage-cost estimates. Actual provider invoices are authoritative.
# OpenAI and Plivo use separate INR presentation rates because the Plivo
# dashboard's account conversion does not match the application's USD rate.
USD_TO_INR_RATE=96.16
PLIVO_USD_TO_INR_RATE=80.00
OPENAI_AUDIO_INPUT_USD_PER_M=10
OPENAI_AUDIO_CACHED_INPUT_USD_PER_M=0.30
OPENAI_AUDIO_OUTPUT_USD_PER_M=20
OPENAI_TEXT_INPUT_USD_PER_M=0.60
OPENAI_TEXT_CACHED_INPUT_USD_PER_M=0.06
OPENAI_TEXT_OUTPUT_USD_PER_M=2.40
# Optional Tamil/full-model overrides. Remove these when Tamil also uses mini.
OPENAI_AUDIO_INPUT_USD_PER_M_TAMIL=32
OPENAI_AUDIO_CACHED_INPUT_USD_PER_M_TAMIL=0.40
OPENAI_AUDIO_OUTPUT_USD_PER_M_TAMIL=64
OPENAI_TEXT_INPUT_USD_PER_M_TAMIL=4
OPENAI_TEXT_CACHED_INPUT_USD_PER_M_TAMIL=0.40
OPENAI_TEXT_OUTPUT_USD_PER_M_TAMIL=24

# Separate ASR transcription model cost (billed apart from the Realtime
# session's own audio/text tokens). Defaults are best-effort estimates for
# gpt-4o-transcribe / gpt-4o-mini-transcribe; verify against OpenAI's current
# pricing and override here if they drift.
OPENAI_TRANSCRIBE_AUDIO_INPUT_USD_PER_M=3
OPENAI_TRANSCRIBE_TEXT_OUTPUT_USD_PER_M=5
OPENAI_TRANSCRIBE_AUDIO_INPUT_USD_PER_M_TAMIL=6
OPENAI_TRANSCRIBE_TEXT_OUTPUT_USD_PER_M_TAMIL=10
# CRM outbox worker. CRM webhook URL and signing secret are stored encrypted
# per organization through the dashboard and are never placed in this file.
# Durable CRM outbox worker (run as a separate process/container).
CRM_WORKER_POLL_SECONDS=5
CRM_WORKER_BATCH_SIZE=20
